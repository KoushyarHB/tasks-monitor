# ── Plane ─────────────────────────────────────────────
PLANE_BASE_URL=https://plane.sabasystem.app
PLANE_WORKSPACE=tms
PLANE_PROJECT_ID=
PLANE_CSRF_TOKEN=
PLANE_SESSION_ID=
PLANE_USER_ID=
PLANE_FOCUS=mine

# ── Telegram ──────────────────────────────────────────
TG_BOT_TOKEN=
TG_CHAT_ID=-1004447454544
TG_PROXY=socks5h://192.168.1.2:1088

# ── Behaviour ─────────────────────────────────────────
POLL_INTERVAL_SECONDS=300
STATE_FILE=./state.json

# ── Plane webhook (receive push events) ───────────────
# Owner must create a webhook in Plane → Workspace Settings → Webhooks
#   URL:    https://<your-public-host>/webhook/plane
#   Secret: PLANE_WEBHOOK_SECRET below
#   Events: Issue (created / updated / deleted)
PLANE_WEBHOOK_SECRET=
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook/plane
WEBHOOK_MIN_INTERVAL_SECONDS=10
